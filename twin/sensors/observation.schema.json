{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://doe2park.github.io/Graduate-Project/twin/sensors/observation.schema.json",
 "title": "One sensor observation (grimes-sensor-feed/1)",
 "type": "object",
 "required": [
  "sensor_id",
  "ts",
  "value",
  "unit",
  "quality",
  "source"
 ],
 "properties": {
  "sensor_id": {
   "type": "string",
   "pattern": "^[a-z0-9-]{1,40}$"
  },
  "ts": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$"
  },
  "value": {
   "type": [
    "number",
    "null"
   ]
  },
  "unit": {
   "type": "string"
  },
  "quality": {
   "type": "string",
   "enum": [
    "good",
    "suspect",
    "missing"
   ]
  },
  "source": {
   "type": "string",
   "enum": [
    "demo-sim",
    "bms",
    "bmo",
    "gateway",
    "fiber"
   ]
  },
  "simulated": {
   "type": "boolean"
  },
  "reason": {
   "type": "string"
  }
 },
 "additionalProperties": false
}
